      <gadget name="unitselectionpanel-uhcTrainPoints" type="formatText" size1024="632 669 698 683" textcenterhoriz="" texttruecentervert="" textmarkup="" formattextusedatareplace="" textcolor="255 255 255" textfont="StatText" textfontsize="10" z="108"/>
