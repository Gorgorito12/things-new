      <gadget name="unitselectionpanel-uhcPop" type="formatText" size1024="344 683 410 697" textcenterhoriz="" texttruecentervert="" textmarkup="" formattextusedatareplace="" textcolor="255 255 255" textfont="StatText" textfontsize="10" z="108"/>
