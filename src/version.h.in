// Generated by CMake from src/version.h.in. Change the version in CMakeLists.txt, in
// project(UHC VERSION ...), not here. Plain macros so that version.rc can include it too.
#ifndef UHC_VERSION_H
#define UHC_VERSION_H

#define UHC_VERSION "@PROJECT_VERSION@"
#define UHC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define UHC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define UHC_VERSION_PATCH @PROJECT_VERSION_PATCH@

#endif
